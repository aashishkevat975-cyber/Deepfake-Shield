{
  "expo": {
    "name": "Fraud Face Detector",
    "slug": "fraud-face-detector",
    "owner": "aashishkevat2s-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.aashishkevat975.fraudfacedetector",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "INTERNET"
      ]
    },
    "web": {
      "favicon": "./icon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you scan scam screenshots."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "72ea23dd-4013-48f4-abff-824b13869ef4"
      }
    }
  }
}
