{
  "expo": {
    "name": "Fraud Face Detector",
    "slug": "fraud-face-detector",
    "owner": "aashish-detectors-team",
    "version": "1.0.5",
    "extra": {
      "eas": {
        "projectId": "cf9fcf83-af5e-421c-9a72-f89e9ad1fc9c"
      }
    },
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.aashish.fraudfacedetector",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "The app needs access to your photos to scan for deepfakes."
        }
      ]
    ]
  }
}
